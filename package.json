{
  "name": "@nexus/shared-ui",
  "version": "0.1.0",
  "description": "Shared UI components, design tokens, and utilities for the Nexus (Mental Mediator) doctor and patient portals",
  "main": "src/index.js",
  "module": "src/index.js",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.js",
    "./components/ui": "./src/components/ui/index.js",
    "./components/profile": "./src/components/profile/ProfileView.js",
    "./hooks": "./src/hooks/useChatHub.js",
    "./context": "./src/context/notificationsContext.js",
    "./auth": "./src/auth/authProvider.js",
    "./api": "./src/api/client.js",
    "./utils": "./src/utils/utcToRelativeTime.js",
    "./tailwind.config.js": "./tailwind.config.js",
    "./index.css": "./index.css"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-router-dom": ">=6.0.0",
    "react-icons": ">=5.0.0",
    "react-hot-toast": ">=2.0.0",
    "framer-motion": ">=11.0.0",
    "react-markdown": ">=9.0.0"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "react-icons": "^5.2.1",
    "react-hot-toast": "^2.4.1",
    "framer-motion": "^11.2.10",
    "react-markdown": "^9.0.1",
    "daisyui": "^4.11.1",
    "tailwindcss": "^3.4.3",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "react-scripts": "5.0.1",
    "@testing-library/react": "^14.2.1",
    "@testing-library/jest-dom": "^6.4.2"
  },
  "scripts": {
    "test": "react-scripts test --watchAll=false",
    "build": "echo 'Shared UI is consumed directly via source; no build step required.'"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AlaaEbrahim0/nexus-shared-ui.git"
  },
  "keywords": ["nexus", "mental-mediator", "shared-ui", "design-system", "react", "tailwind", "daisyui"]
}
